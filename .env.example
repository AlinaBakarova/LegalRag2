# Copy to .env; relative data paths are resolved from the launch directory.
# Prefer an absolute path outside this checkout for persistent documents.
LEGAL_WORKSPACE_DATA_DIR=/workspace/legal-workspace-data
LEGAL_WORKSPACE_HOST=127.0.0.1
LEGAL_WORKSPACE_PORT=8080
LEGAL_WORKSPACE_POLL_INTERVAL_SECONDS=0.5
LEGAL_WORKSPACE_HEARTBEAT_INTERVAL_SECONDS=2
LEGAL_WORKSPACE_LEASE_SECONDS=30
LEGAL_WORKSPACE_WORKER_STALE_AFTER_SECONDS=10
