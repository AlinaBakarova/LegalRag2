# Copy to .env; relative data paths are resolved from the launch directory.
# Prefer an absolute path outside this checkout for persistent documents.
LEGAL_WORKSPACE_DATA_DIR=/workspace/legal-workspace-data
LEGAL_WORKSPACE_HOST=127.0.0.1
LEGAL_WORKSPACE_PORT=8080
LEGAL_WORKSPACE_POLL_INTERVAL_SECONDS=0.5
LEGAL_WORKSPACE_HEARTBEAT_INTERVAL_SECONDS=2
LEGAL_WORKSPACE_LEASE_SECONDS=30
LEGAL_WORKSPACE_WORKER_STALE_AFTER_SECONDS=10

# CPU threads used by the local embedding model.
LEGAL_WORKSPACE_EMBEDDING_THREADS=2

# Local generation through Ollama. Embeddings/indices use their existing configuration.
LEGAL_WORKSPACE_OLLAMA_URL=http://127.0.0.1:11434
LEGAL_WORKSPACE_LLM_MODEL=qwen3:4b
LEGAL_WORKSPACE_LLM_TIMEOUT_SECONDS=180
LEGAL_WORKSPACE_LLM_TOTAL_TIMEOUT_SECONDS=360
LEGAL_WORKSPACE_LLM_CONTEXT_TOKENS=8192
LEGAL_WORKSPACE_LLM_OUTPUT_TOKENS=1024
LEGAL_WORKSPACE_LLM_MAX_CALLS=3
